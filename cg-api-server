#!/bin/sh
ARTIFACT='com.jfeat:cg-api:1.3.1'
artifact='cg-api-1.3.1.jar'
testcase='cg-api-test.http'
TMP_DIR="${TMPDIR:-/var/tmp}"
artifact_path="$TMP_DIR/$artifact"
mkdir -p "$TMP_DIR" 2> /dev/null

usage() {
	cat <<- EOF
    Usage: cg-api-server [OPTIONS]

    OPTIONS:
      -h --help           -- print usage
      -p --port <PORT>    -- running port other than 8080
      -f --force          -- force to update the standalone jar and cg-api-test.http
      -t --testcase       -- open ct-api-test.http only
	EOF
	exit
}
## check options
port_opt=$9
port_arg=$9
force_opt=$9
testcase_opt=$9
for opt in $@;do
   if [[ $opt = '-h' || $opt = '--help' ]];then 
     usage
   elif [[ $opt = '-p' || $opt = '--port' ]];then 
     port_opt=$opt
   elif [[ $opt = '-f' || $opt = '--force' ]];then 
     force_opt=$opt
   elif [[ $opt = '-t' || $opt = '--test' ]];then 
     testcase_opt=$opt
   elif [ $port_opt ];then
     port_arg=$opt
     unset port_opt
   fi
done
if [[ $port_opt && ! $port_arg ]];then 
   usage
fi


## main

get_test_http(){
  echo jar xf $artifact_path BOOT-INF/classes/$testcase
  jar xf "$artifact_path" BOOT-INF/classes/$testcase
  echo mv BOOT-INF/classes/$testcase "$TMP_DIR/$testcase"
  mv BOOT-INF/classes/$testcase "$TMP_DIR/$testcase"
  rmdir BOOT-INF/classes 2> /dev/null
  rmdir BOOT-INF 2> /dev/null
}

if [[ ! $port_opt && $port_arg ]];then 
   port_opt="--server.port=$port_arg"
fi


## #####################
## get artifacdt
## #####################

## get cg-api-1.3.1.jar
if [[ $force_opt || ! -f "$artifact_path" ]];then
  ## comment out: do not need to remove the old one
  # if [ -f $artifact ];then 
  #   echo rm -f $artifact
  #   rm -f $artifact
  # fi
  # if [ -f $artifact ];then 
  #   echo fail to rm $artifact, rm -f /tmp/$artifact manually ..
  #   exit
  # fi
  echo mvn org.apache.maven.plugins:maven-dependency-plugin:3.6.0:copy -Dartifact="$ARTIFACT" -DoutputDirectory="$TMP_DIR" -U
  mvn org.apache.maven.plugins:maven-dependency-plugin:3.6.0:copy -Dartifact="$ARTIFACT" -DoutputDirectory="$TMP_DIR" -U  # -DoutputDirectory=./
  if [ ! -f "$artifact_path" ];then
    echo "fail to get $artifact from mvn maven-dependency-plugin:3.6.0:copy !" > /dev/stderr
    exit
  fi

  ## update cg-api-test.http as well only when artifact exist
  get_test_http
fi


## #####################
## get testcase
## #####################

# ls $artifact
if [ ! -f "$TMP_DIR/$testcase" ];then
  get_test_http
  if [ ! -f "$TMP_DIR/$testcase" ];then
    echo fail to get $testcase > /dev/stderr
    exit
  fi  
fi

## #####################
## code testcase
## #####################

if [ $testcase_opt ];then
  ## end get test.http
  if [ ! -z "$(which code)" ];then 
    code "$TMP_DIR/$testcase"
  else
    echo "vscode not installed or code cli not detected 锛? > /dev/stderr
  fi
  ## exit any way for -t 
  exit
fi


## #####################
## run server
## #####################

if [ ! -z "$(which code)" ];then 
  code "$TMP_DIR/$testcase"
fi

## run
echo java -jar "$artifact_path" $port_opt
java -jar "$artifact_path" $port_opt

